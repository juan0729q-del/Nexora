NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
# Pega solo el valor de los meta tags de Search Console/Bing, nunca el HTML completo.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

ADMIN_PASSWORD=usa-una-contrasena-larga-y-unica
ADMIN_SESSION_SECRET=genera-un-secreto-aleatorio-de-32-caracteres-o-mas
CRON_SECRET=protege-los-endpoints-de-automatizacion
CATALOG_IMPORT_SECRET=secreto-unico-para-la-importacion-inicial-protegida
CATALOG_AUTOMATION_ENABLED=true
INTELLIGENCE_MODE=shadow

# API Key de CJ, no un access token. Solo existe en el servidor.
CJ_DROPSHIPPING_API_KEY=api-key-de-cj-solo-servidor
CJ_DROPSHIPPING_REQUEST_TIMEOUT_MS=12000
# Reserva preventiva antes de gastar puntos de CJ en una nueva consulta.
CJ_MINIMUM_POINTS_RESERVE=200
# El checkout reserva 20 puntos para variantes con VID y 30 para referencias
# antiguas que aún requieren descubrirlo; no suma una reserva artificial.
CJ_CHECKOUT_MINIMUM_POINTS_RESERVE=0
# Espera comunicada al navegador cuando CJ confirma falta real de puntos.
CJ_QUOTA_RETRY_AFTER_SECONDS=60
# Opcional: endpoint oficial de CJ para enriquecer costo por SKU. Debe usar
# developers.cjdropshipping.com; el inventario usa queryBySku automáticamente.
CJ_DROPSHIPPING_PRODUCT_SYNC_URL=

# Para inventario crítico, checkout vuelve a verificar CJ antes del cobro.
CHECKOUT_STOCK_VERIFICATION_THRESHOLD=4
CHECKOUT_STOCK_SAFETY_BUFFER=1
# Cotizaciones de flete real: el token cifra costo CJ y dirección, y vence en
# pocos minutos. Usa un valor aleatorio distinto de las llaves del proveedor.
CHECKOUT_QUOTE_SECRET=genera-un-secreto-aleatorio-de-32-caracteres-o-mas
CJ_SHIPPING_QUOTE_TTL_SECONDS=300
# Durante este intervalo el checkout reutiliza el inventario firmado que CJ
# acaba de devolver al cotizar y evita gastar otros puntos inmediatamente.
CJ_INVENTORY_QUOTE_TRUST_SECONDS=120
CJ_INVENTORY_SAFETY_BUFFER=1
# Límite local por cliente/proceso; complementa una regla de Rate Limiting/WAF
# de Vercel sobre POST /api/shipping/quotes para proteger puntos de CJ.
CJ_SHIPPING_QUOTE_MAX_PER_MINUTE=5
# Segunda barrera local para evitar dobles intentos de checkout. Compleméntala
# con Rate Limiting del Firewall de Vercel en producción.
CHECKOUT_MAX_PER_MINUTE=4
# No abrir una pasarela si el libro privado no pudo registrar producto+flete.
REQUIRE_SALES_LEDGER_FOR_CHECKOUT=true
USD_TO_COP_RATE=valor-aprobado-cop-por-usd
# Fecha UTC en que el propietario aprobó la tasa anterior. Nexora rechaza
# tasas con más de siete días para impedir totales y márgenes desactualizados.
USD_TO_COP_RATE_UPDATED_AT=AAAA-MM-DDTHH:mm:ssZ
# Precio mínimo de importación: 50 % de contribución después de la comisión
# Wompi. No incluye flete/CAC hasta que los cargues como reserva real.
CATALOG_TARGET_CONTRIBUTION_MARGIN=0.50
CATALOG_LANDED_COST_RESERVE_COP=0

PAYMENT_PROVIDER=wompi
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_o_pub_prod_del_comercio
WOMPI_INTEGRITY_SECRET=test_integrity_o_prod_integrity_solo_servidor
WOMPI_PRIVATE_KEY=opcional_para_crear_links_API_prv_test_o_prv_prod
# Secreto de eventos configurado en Wompi para validar POST /api/payments/wompi/webhook.
WOMPI_EVENT_SECRET=secreto-de-eventos-de-wompi-solo-servidor
# Debe coincidir con la URL de eventos de Wompi que registraste: prod o test.
WOMPI_EVENT_ENVIRONMENT=prod
WOMPI_API_BASE_URL=https://production.wompi.co
# Plan Avanzado observado: 2,65 % + COP 700 + IVA sobre la comisión. Ajusta
# sólo si Wompi confirma una tarifa contractual distinta para tu comercio.
WOMPI_FEE_PERCENTAGE=0.0265
WOMPI_FEE_FIXED_COP=700
WOMPI_FEE_VAT_RATE=0.19
# Adaptador reservado: no seleccionar mercadopago hasta implementar su
# conciliación/postventa con el mismo rigor que Wompi.
MERCADOPAGO_ACCESS_TOKEN=clave-solo-servidor

# PayPal Checkout para Estados Unidos. Client ID, Secret y Webhook ID son
# variables exclusivas del servidor; no uses prefijo NEXT_PUBLIC_. El gate
# permanece en false hasta validar Live, el webhook y el libro privado.
PAYPAL_CLIENT_ID=client-id-live-o-sandbox-solo-servidor
PAYPAL_CLIENT_SECRET=secret-live-o-sandbox-solo-servidor
PAYPAL_WEBHOOK_ID=id-del-webhook-creado-en-la-misma-app-y-entorno
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CHECKOUT_ENABLED=false

# Medición externa opcional. Si un identificador queda vacío, su plataforma
# no carga. Los UTM sólo se persisten después del consentimiento del usuario.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Feeds Merchant Center. Deben permanecer en false hasta que estén aprobadas
# las políticas públicas y la configuración real de envío/devoluciones.
MERCHANT_CENTER_FEED_ENABLED=false
MERCHANT_CENTER_POLICIES_APPROVED=false
MERCHANT_CENTER_US_APPROVED=false

# Identidad comercial pública: completa únicamente datos legales aprobados.
NEXT_PUBLIC_MERCHANT_LEGAL_NAME=
NEXT_PUBLIC_MERCHANT_ADDRESS=
NEXT_PUBLIC_MERCHANT_TAX_ID=

# Datos públicos aprobados por el propietario. No agregues información privada.
NEXT_PUBLIC_CONTACT_EMAIL=nexoraventas1@gmail.com
NEXT_PUBLIC_CONTACT_WHATSAPP_URL=https://wa.me/573024595220
NEXT_PUBLIC_CONTACT_WHATSAPP_LABEL=+57 302 459 5220
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61592349341501
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/nexoraventas1/
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@nexora.diseo.con

# Libro privado de ventas y postventa. Apps Script se ejecuta bajo la cuenta
# de Nexora; la URL /exec puede ser pública porque cada POST lleva una
# envoltura HMAC que vence a los cinco minutos. Nunca guardar datos de
# clientes en Git.
GOOGLE_SHEETS_SYNC_ENABLED=true
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/ID_DEL_DESPLIEGUE/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=secreto-aleatorio-de-32-caracteres-o-mas
GOOGLE_SHEETS_REQUEST_TIMEOUT_MS=25000
